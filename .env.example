# Read-only connection string for the database SQLsage analyzes
SQLSAGE_DATABASE_URL=postgres://sqlsage_readonly:password@localhost:5432/app

# LLM provider: anthropic | ollama
SQLSAGE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
SQLSAGE_OLLAMA_URL=http://localhost:11434
SQLSAGE_OLLAMA_MODEL=qwen2.5-coder

# Data egress policy: none | schema | schema+results
SQLSAGE_EGRESS=schema

# Query guardrails
SQLSAGE_STATEMENT_TIMEOUT_MS=5000
SQLSAGE_ROW_LIMIT=500
